# Copy these into the existing private .env; retain existing secrets and state.
# Never put a real secret or certificate into Git.
WORKSPACE_GATEWAY_SECRET=replace-with-a-new-independent-random-secret
# Production needs a separately registered workspace site. Replace all placeholders.
WORKSPACE_GATEWAY_DOMAIN=nodes.example-workspace.com
WORKSPACE_GATEWAY_CONTROL_HOST=connect.example-workspace.com
WORKSPACE_GATEWAY_PUBLIC_URL=https://connect.example-workspace.com
# NEXTAUTH_URL remains the existing HTTPS portal origin in .env.
WORKSPACE_NGINX_CONFIG_DIR=/absolute/path/to/rendered/workspace-nginx
WORKSPACE_CONTROL_CERT_DIR=/absolute/path/to/control-cert
WORKSPACE_NODE_CERT_DIR=/absolute/path/to/node-wildcard-cert
# Both directories must contain fullchain.pem and privkey.pem (symlink targets
# must remain within the mounted directory). Control cert SAN covers CONTROL_HOST;
# node cert SAN must include *.nodes.example-workspace.com. Obtain with DNS-01.
WORKSPACE_INGRESS_SUBNET=172.30.80.0/29
WORKSPACE_INGRESS_NGINX_IP=172.30.80.2
WORKSPACE_INGRESS_GATEWAY_IP=172.30.80.3
# Resource defaults are already explicit in docker-compose.workspace.yml. Tune only
# after capacity validation; requests can be refused before these process limits.
WORKSPACE_GATEWAY_BUFFER_BYTES=134217728
WORKSPACE_GATEWAY_UVICORN_CONCURRENCY=256
WORKSPACE_GATEWAY_WS_MAX_QUEUE=2
WORKSPACE_GATEWAY_HTTP_LIMIT=2097152
