# Generated by tools/workspace/render_ingress.py. Do not hand-edit the generated file.
map $http_upgrade $workspace_connection_upgrade {
    default upgrade;
    '' close;
}
map $host $workspace_ingress_key {
    default gateway;
}
map $status $workspace_retry_after {
    default '';
    429 60;
}
limit_req_zone $binary_remote_addr zone=workspace_pairing:1m rate=5r/m;
limit_req_zone $binary_remote_addr zone=workspace_state:1m rate=120r/m;
limit_req_zone $binary_remote_addr zone=workspace_control:1m rate=30r/m;
limit_req_zone $binary_remote_addr zone=workspace_request:1m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=workspace_per_ip:1m;
limit_conn_zone $workspace_ingress_key zone=workspace_total:1m;

upstream workspace_gateway {
    # This alias exists only on the dedicated ingress network.
    server workspace-ingress-upstream:8090;
}

# The optional overlay rejects unmatched hosts instead of selecting a portal server.
server {
    listen 80 default_server;
    server_name _;
    access_log off;
    error_log /dev/null;
    return 444;
}
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    access_log off;
    error_log /dev/null;
    return 444;
}

# Wildcard certificates require DNS-01. No workspace ACME HTTP endpoint is opened.
# Reject HTTP launch URLs so tickets cannot enter redirects or HTTP logs.
server {
    listen 80;
    server_name @@CONTROL_HOST@@ "~^[a-f0-9]{24}\.@@NODE_DOMAIN_REGEX@@$";
    access_log off;
    error_log /dev/null;
    return 444;
}

server {
    listen 443 ssl;
    http2 on;
    server_name @@CONTROL_HOST@@;
    ssl_certificate /etc/nginx/workspace-tls/control/fullchain.pem;
    ssl_certificate_key /etc/nginx/workspace-tls/control/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    # Query strings, Authorization, and Referer never enter workspace logs.
    access_log off;
    error_log /dev/null;
    client_max_body_size 16k;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 15s;
    send_timeout 30s;
    limit_conn workspace_per_ip 32;
    limit_conn workspace_total 240;
    limit_conn_status 429;
    limit_req_status 429;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Origin-Agent-Cluster "?1" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Retry-After $workspace_retry_after always;
    include /etc/nginx/workspace-enabled/workspace-proxy.inc;

    location = /v1/connector/pairings {
        if ($request_method != POST) { return 405; }
        limit_req zone=workspace_pairing burst=5 nodelay;
        proxy_pass http://workspace_gateway;
    }
    location = /v1/connector/state {
        if ($request_method != GET) { return 405; }
        limit_req zone=workspace_state burst=20 nodelay;
        proxy_pass http://workspace_gateway;
    }
    location = /v1/connector/approve {
        if ($request_method != POST) { return 405; }
        limit_req zone=workspace_control burst=10 nodelay;
        proxy_pass http://workspace_gateway;
    }
    location = /v1/connector/revoke {
        if ($request_method != POST) { return 405; }
        limit_req zone=workspace_control burst=10 nodelay;
        proxy_pass http://workspace_gateway;
    }
    location = /v1/connector/tunnel {
        if ($request_method != GET) { return 405; }
        limit_req zone=workspace_control burst=10 nodelay;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_pass http://workspace_gateway;
    }
    # Includes /v1/accounts, /health, future connector routes, and trailing suffixes.
    location / { return 404; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name "~^[a-f0-9]{24}\.@@NODE_DOMAIN_REGEX@@$";
    ssl_certificate /etc/nginx/workspace-tls/node/fullchain.pem;
    ssl_certificate_key /etc/nginx/workspace-tls/node/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    access_log off;
    error_log /dev/null;
    client_max_body_size @@HTTP_BODY_LIMIT@@;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 15s;
    send_timeout 30s;
    limit_conn workspace_per_ip 32;
    limit_conn workspace_total 240;
    limit_conn_status 429;
    limit_req_status 429;
    limit_req zone=workspace_request burst=40 nodelay;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Origin-Agent-Cluster "?1" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Retry-After $workspace_retry_after always;
    include /etc/nginx/workspace-enabled/workspace-proxy.inc;

    location ^~ /v1/ { return 404; }
    location ^~ /api/remote-workspace { return 403; }
    location = /_ambient/launch {
        proxy_pass http://workspace_gateway;
    }
    location /ws/ {
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_pass http://workspace_gateway;
    }
    location / { proxy_pass http://workspace_gateway; }
}
