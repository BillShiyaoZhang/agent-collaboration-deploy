proxy_http_version 1.1;
proxy_bind @@NGINX_IP@@;
proxy_set_header Host $host;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $workspace_connection_upgrade;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header Forwarded "";
proxy_set_header X-Forwarded-For "";
proxy_set_header X-Forwarded-Host "";
proxy_set_header X-Forwarded-Port "";
proxy_set_header X-Forwarded-Proto "";
proxy_set_header X-Original-URL "";
proxy_set_header X-Rewrite-URL "";
proxy_set_header X-Account-ID "";
proxy_set_header X-Node-ID "";
proxy_set_header X-Grant-ID "";
proxy_connect_timeout 5s;
proxy_read_timeout 35s;
proxy_send_timeout 35s;
# Let the Gateway reserve a node slot before reading slow request bodies.
proxy_request_buffering off;
proxy_buffering off;
proxy_cache off;
# Keep one consistent backoff value for nginx and Gateway 429 responses.
proxy_hide_header Retry-After;
# Workspace responses cannot relax browser origin isolation.
proxy_hide_header Origin-Agent-Cluster;
proxy_hide_header Cross-Origin-Opener-Policy;
