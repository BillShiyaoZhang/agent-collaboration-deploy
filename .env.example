# Copy to .env and replace both secrets before deployment.
# Keep existing secrets when upgrading an existing installation.
NEXTAUTH_SECRET=
PLATFORM_ADMIN_TOKEN=
NEXTAUTH_URL=https://agent-communication.online

# Only used with docker-compose.v2.yml. Keep private keys in separate host
# files, not in this .env file or the repository. Use absolute host paths.
