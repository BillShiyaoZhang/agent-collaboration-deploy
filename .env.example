# Copy to .env and replace both secrets before deployment.
# Keep existing secrets when upgrading an existing installation.
NEXTAUTH_SECRET=
PLATFORM_ADMIN_TOKEN=
NEXTAUTH_URL=https://agent-communication.online

# Transactional account email (Resend). Leave the key empty only for local/offline
# checks; new registrations and password email flows require a configured sender.
# Human support uses Alibaba Mail Free Edition; enable it after real send/receive checks.
# Alibaba mailbox passwords and SMTP security passwords are never used by the Web app.
RESEND_API_KEY=
AUTH_EMAIL_FROM="Agent Comm <accounts@notify.agent-communication.online>"
# Optional: keep empty until the human mailbox can receive replies.
AUTH_EMAIL_REPLY_TO=""
# Resend Free allows 100 recipients/day; reserve 10 for operational tests.
AUTH_EMAIL_DAILY_LIMIT=90
# Optional public contact, baked into the production bundle; keep empty until mail works.
# Setting/changing it requires rebuilding the Web image, not just restarting it.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Only used with docker-compose.v2.yml. Keep private keys in separate host
# files, not in this .env file or the repository. Use absolute host paths.
# AGENT_V2_PLATFORM_CONFIG=
# AGENT_V2_POLICY_FILE=
# AGENT_V2_ROOT_PUBLIC_FILE=
# AGENT_V2_GATEWAY_PRIVATE_FILE=
# AGENT_V2_RECEIPT_PRIVATE_FILE=
# AGENT_V2_MANAGED_ISSUER_PRIVATE_FILE=
# AGENT_V2_POLICY_ROOT_PUBLIC_KEY_HEX=
# AGENT_V2_PLATFORM_ID=
